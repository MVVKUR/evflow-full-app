# Template — copy to .env and fill in secrets. Safe to commit.

# Database. Production sets a full DATABASE_URL (compose files do). For local
# dev without a full URL, set at least POSTGRES_PASSWORD; the rest default to
# evflow / localhost:5432 / evflow. There is no baked-in default password.
# DATABASE_URL=postgresql+psycopg://evflow:yourpassword@localhost:5432/evflow
POSTGRES_USER=evflow
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=evflow

DATA_DIR=./data
RAW_DIR=./data/raw
PROCESSED_DIR=./data/processed
OUTPUT_DIR=./output
FIGURES_DIR=./output/figures

OCM_API_KEY=your_openchargemap_key_here
OCM_API_URL=https://api.openchargemap.io/v3/poi
OCM_COUNTRY_CODE=ID
OCM_MAX_RESULTS=5000

OVERPASS_API_URL=https://overpass-api.de/api/interpreter
GEOFABRIK_JAVA_PBF_URL=https://download.geofabrik.de/asia/indonesia/java-latest.osm.pbf
GEOFABRIK_JAVA_PBF_PATH=./data/raw/java-latest.osm.pbf

# Turn-by-turn navigation (AC 2.4.1) comes from OSRM, with the local OSM graph in
# api/routing.py as the second road provider. The default below is the PUBLIC
# OSRM demo server: it is rate-limited and explicitly not for production use.
# Point this at a self-hosted OSRM for any deployment that people actually
# navigate with.
#
# When BOTH road providers fail the two routing endpoints behave differently, on
# purpose:
#   POST /api/v1/route-plans                 -> 503. Planning refuses rather than
#                                               draw a straight line across a map.
#   POST /api/v1/route-plans/active/evaluate -> 200, using a straight-line
#                                               estimate, because a driver already
#                                               under way must keep getting battery
#                                               warnings (AC 2.1.1 / AC 2.4.2).
# The degraded answer is always labelled, never disguised:
# assumptions.routing_provider == 'haversine_fallback',
# assumptions.turn_by_turn_available == false, assumptions.distance_basis ==
# 'straight_line', and a 'routing_degraded' entry in `advisories` (which never
# displaces the battery `warning`).
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving
# Ceiling on a SINGLE provider attempt. NOTE: this is not a ceiling on the
# request. One plan makes up to 1 + 2*ROUTE_MAX_ROAD_VALIDATION_CANDIDATES
# routing calls, and each call may try httpx and then a curl retry, so these
# attempts stack. Use ROUTING_TOTAL_BUDGET_SECONDS below to bound the response.
# (The code default is 10.0; this file has long shipped 3.0. Whichever you
# deploy, the total budget is what protects the proxy.)
ROUTING_TIMEOUT_SECONDS=3.0
# TOTAL wall clock one request may spend on road routing, across every provider
# and every call it makes. The curl retry runs INSIDE this budget with whatever
# time is left, never on a fresh full timeout. Once it is spent the request stops
# trying providers and degrades instead of burning more time.
#
# 12s is chosen against the production nginx limit of 30s: it leaves ~18s of
# headroom for the station queries, energy maths and serialisation, so even a
# request that spends the whole budget still returns a real response instead of
# a 504 that reaches nobody. It is also >= one full ROUTING_TIMEOUT_SECONDS, so
# a single slow-but-healthy OSRM call still gets its complete chance.
#
# Degrading on an exhausted budget changes only the WAIT, never the contract:
# POST /api/v1/route-plans still refuses with a 503 rather than fabricate a
# route, and POST /api/v1/route-plans/active/evaluate still answers with the
# labelled straight-line estimate described above.
#
# Raise this only in step with the proxy timeout. Set to 0 to disable the budget
# entirely (unbounded, and not advisable behind a proxy).
ROUTING_TOTAL_BUDGET_SECONDS=12.0
# A routed distance below this for endpoints further apart than this is the
# provider answering off its map; such a reply is discarded instead of being
# published as a healthy 0 km "direct route".
ROUTING_DEGENERATE_ROUTE_KM=0.5
# Average speed (km/h) used to turn the degraded straight-line distance above
# into a remaining duration / ETA. Only ever used when no road provider answered.
ROUTING_FALLBACK_SPEED_KMH=40.0

# Route service area (AC 2.2.1 / AC 2.2.2). Origin and destination outside this
# box are rejected by POST /api/v1/route-plans with a field-specific 422 and NO
# route is generated. This is a product boundary — it is NOT the OSM graph
# download extent in JAKARTA_BBOX_* above.
#
# The default is the whole Indonesian archipelago because that is what this
# repository actually SEEDS: 2,900+ stations reaching Sumatra, Kalimantan,
# Sulawesi, Bali and Papua (observed extent lat -10.21..5.88, lon 95.32..140.70).
# A Jabodetabek-sized box left ~49% of the shipped stations un-routable while
# /api/v1/stations, /api/v1/stations/nearby and /api/v1/geocoding/search went on
# offering them — the picker suggesting destinations the planner then refused.
# Serve what you ship; Sydney, Perth and the Pacific are still rejected. Being a
# RECTANGLE, it also admits Singapore, peninsular Malaysia, Brunei, Timor-Leste
# and part of PNG — accepted but with no seeded stations, which surfaces honestly
# as route_status='no_suitable_station' rather than a silently wrong route.
#
# Narrowing this is safe: Station.in_service_area and GeocodingItem.in_service_area
# are computed from THESE values, so discovery follows the boundary automatically
# and /api/v1/geocoding/search?in_service_area_only=true drops what the planner
# would refuse. Narrow it to Jabodetabek with SOUTH=-7.35 WEST=105.90
# NORTH=-5.60 EAST=108.30.
#
# NOT applied to POST /api/v1/route-plans/active/evaluate: a driver already on an
# active route must keep receiving battery warnings (AC 2.1.1 / AC 2.4.2), so
# that endpoint reports out_of_service_area as an advisory instead of a 422.
ROUTE_SERVICE_AREA_NAME=Indonesia (national SPKLU coverage)
ROUTE_SERVICE_AREA_SOUTH=-11.20
ROUTE_SERVICE_AREA_WEST=94.60
ROUTE_SERVICE_AREA_NORTH=6.30
ROUTE_SERVICE_AREA_EAST=141.30
# Set false ONLY for a deployment that genuinely serves everywhere.
ROUTE_SERVICE_AREA_ENFORCED=true

# Charging-preference weights (AC 2.2.4). rank_score is in km-equivalent and
# lower is better: score = detour_km * detour_weight - available_kw * power_weight.
# prefer_fast_charging=true swaps ROUTE_RANK_POWER_WEIGHT for the FAST weight,
# false swaps in the MIN_DETOUR one; route_type='shortest' swaps
# ROUTE_RANK_DETOUR_WEIGHT for the SHORTEST one. The applied values are echoed
# back in assumptions.rank_detour_weight / rank_power_weight_km_per_kw.
ROUTE_RANK_DETOUR_WEIGHT=1.0
ROUTE_RANK_POWER_WEIGHT=0.05
ROUTE_RANK_FAST_POWER_WEIGHT=0.25
ROUTE_RANK_MIN_DETOUR_POWER_WEIGHT=0.0
ROUTE_RANK_SHORTEST_DETOUR_WEIGHT=2.0

# AC 2.2.3 manual-range planning: efficiency assumed when a driver sends
# vehicle.usable_range_km without a battery_kwh.
ROUTE_MANUAL_EFFICIENCY_WH_PER_KM=180.0

# Routing endpoint (/api/v1/route, Dijkstra). Build once with
# `python scripts/build_road_graph.py`, then the API loads this GraphML at runtime.
ROAD_GRAPH_PATH=./data/processed/jakarta_drive.graphml
ROUTING_DEFAULT_SPEED_KMH=40
# Range-aware nearest-station (Route & Battery): discount + reserve applied to the
# EV model's manufacturer range when deriving remaining range from current_soc.
ROUTING_RANGE_SAFETY_FACTOR=0.85
# EV model catalogue source (defaults to the committed ev_dataset.zip if unset).
EV_DATASET_CSV=./data/raw/indonesia_ev_specs_pricing_2026.csv

SPKLU_JAKARTA_PATH=./data/raw/spklu_jakarta.csv
BPS_JAKARTA_PATH=./data/raw/bps_jakarta_vehicles.csv

KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET=arsan5623/indonesia-electric-vehicle-ev-dataset-2026
KAGGLE_DATA_PATH=./data/raw/kaggle_indonesia_ev

JAKARTA_BBOX_SOUTH=-6.3760
JAKARTA_BBOX_WEST=106.6894
JAKARTA_BBOX_NORTH=-6.0890
JAKARTA_BBOX_EAST=106.9710
JAKARTA_CENTER_LAT=-6.2088
JAKARTA_CENTER_LON=106.8456

REQUEST_TIMEOUT_SECONDS=30
USER_AGENT=ev-charging-analysis-jakarta/0.1

# Xendit (payment). Backend uses the SECRET key; public key is frontend-only.
XENDIT_SECRET_KEY=your_xendit_development_secret_key
XENDIT_PUBLIC_KEY=your_xendit_development_public_key
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_CALLBACK_TOKEN=set_a_webhook_verification_token

# Auth (JWT + Google OAuth)
JWT_SECRET=generate_a_long_random_secret
JWT_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-domain/api/v1/auth/google/callback
FRONTEND_URL=https://your-frontend

# Email (password-reset). Works with any SMTP provider (Gmail app password,
# SendGrid, Amazon SES, Mailgun, Brevo). If SMTP_HOST is unset, forgot-password
# still returns 200 but sends nothing.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=you@gmail.com
# SMTP_SSL=false        # true (or port 465) for implicit TLS
# SMTP_STARTTLS=true    # default true on port 587
PASSWORD_RESET_TTL_MINUTES=60

# Geocoding proxy (/api/v1/geocoding/*). These endpoints are intentionally open:
# the demo password ships in the web bundle, so a token would prove nothing while
# breaking the destination picker. Abuse is contained by volume instead — a
# per-IP budget, a global budget, a response cache, and a minimum interval
# between outbound calls. Nominatim's usage policy also requires a contact
# address in the User-Agent: set a real, monitored address or OSM may block this
# deployment's IP. Unset falls back to a role placeholder.
NOMINATIM_CONTACT_EMAIL=ops@your-domain.example
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org   # override to self-host
# NOMINATIM_MIN_INTERVAL_SECONDS=1.0   # OSM policy is ~1 request/second

# Geocoding cache retention. The SEARCH cache is keyed on a place name plus a
# ~1.1 km origin bucket, so it may live a while. The REVERSE cache is keyed on
# the caller's own (coarsened) position — that IS a location record, so AC 2.3.3
# caps it at 30 seconds. Do not raise it past 30 without re-reading that AC.
GEOCODING_SEARCH_CACHE_TTL_SECONDS=300.0
GEOCODING_REVERSE_CACHE_TTL_SECONDS=30.0

# The TTL above is enforced by a background task started with the app, which
# sleeps until the next cached entry is actually DUE and then deletes it. This is
# what makes the 30-second bound hold on a completely idle process: expiry used
# to run only when something else was written to the cache, so with no further
# traffic an entry outlived its deadline indefinitely. The value below is only
# how long that task sleeps when NOTHING is cached; it never delays a deletion.
GEOCODING_CACHE_SWEEP_IDLE_POLL_SECONDS=5.0

# AC 2.2.7: destination suggestions must carry estimated distances even when the
# client has no GPS fix yet (first launch, permission denied). With no origin,
# distances are measured from this reference point and every item is tagged
# distance_from='reference_point' with this label, instead of returning nulls.
GEOCODING_FALLBACK_ORIGIN_LAT=-6.2088
GEOCODING_FALLBACK_ORIGIN_LON=106.8456
GEOCODING_FALLBACK_ORIGIN_LABEL=Jakarta

# Demo accounts for `python -m scripts.seed_db`. ALL OPT-IN — leave unset in
# production. There is no baked-in demo password: with DEMO_USER_PASSWORD unset
# the seeder skips demo users entirely instead of inventing one.
DEMO_USER_PASSWORD=
# Seed a starting wallet balance for the demo accounts. Default OFF so a
# production re-seed can never mint spendable money. When on, the balance is
# granted exactly once and always with a matching row in the topups ledger.
SEED_DEMO_WALLET=false
DEMO_WALLET_BALANCE_IDR=500000
