    "print(\" - raw path: data/raw/indonesia_ev_specs_pricing_2026.csv\")\n",
    "print(\" - processed path: data/processed/indonesia_ev_cleaned.csv\")\n",
    "print(f\"Total unique EV models catalogued: {len(df_cleaned)}\")"
   ],
   "id": "export-code"
  }
